// Icon index 0 is the language bar icon (RegisterProfile in Dll.cpp).
#include <winver.h>

1 ICON "../Resources/KazType.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "KazType Kazakh input method"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "KazType"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
